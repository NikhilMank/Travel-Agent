# Environment variables for the Travel Agent
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Options - Choose one (or keep both)
# =============================================================================

# Option 1: OpenRouter (free tier)
# Get your key from https://openrouter.ai/settings
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option 2: OpenCode with Anthropic-compatible API
# Get your key from your OpenCode workspace
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_BASE_URL=https://opencode.ai/zen
OPENCODE_MODEL=minimax-m2.5-free

# =============================================================================
# Optional: Travel APIs (for enhanced trip planning)
# =============================================================================

# OpenTripMap - https://opentripmap.com/ (free tier: 10,000 credits/month)
OPENTRIPMAP_API_KEY=your_opentripmap_api_key_here

# Amadeus - https://developers.amadeus.com/ (free developer tier)
AMADEUS_API_KEY=your_amadeus_api_key_here
AMADEUS_API_SECRET=your_amadeus_api_secret_here

# Tavily - https://tavily.com/ (free tier for web search)
TAVILY_API_KEY=your_tavily_api_key_here